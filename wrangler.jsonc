{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www-lassetange-com",
  "main": "dist/server/main.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/cloudflare/assets",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL",
      // Keep in sync with CONTACT_DESTINATION in src/components/contact-form-action.ts.
      "destination_address": "lassetange@gmail.com"
    }
  ]
  // TURNSTILE_SECRET_KEY is a Worker secret, not a var: `wrangler secret put TURNSTILE_SECRET_KEY`.
  // Never put it in this file — wrangler.jsonc is committed.
}
