{
  "name": "www.lassetange.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "rshono dev",
    "build": "rshono build",
    "typecheck": "tsc --noEmit",
    "preview": "rshono build && wrangler dev",
    "deploy": "rshono build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@rshono/core": "^1.0.0-rc.15",
    "hono": "^4.12.31",
    "marked": "^18.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.23",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.115.0"
  }
}
